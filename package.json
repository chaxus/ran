{
  "name": "@ran/monorepo",
  "version": "1.0.0",
  "description": "Monorepo",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "clean": "sh ./bin/clean.sh",
    "build": "sh ./bin/build.sh",
    "test": "sh ./bin/test.sh",
    "lint": "sh ./bin/lint.sh",
    "lint:es": "oxlint --config .oxlintrc.json .",
    "lint:fix": "oxlint --config .oxlintrc.json --fix .",
    "lint:prettier": "prettier --check --cache .",
    "format": "prettier --write --cache .",
    "cpd": "jscpd ./packages",
    "verify:docs": "node bin/sync-design-docs.ts --check && pnpm verify:agent-plugin && pnpm -F ranui doc:api:check && pnpm -F ranui doc:style:check && pnpm -F ranui doc:changelog:check && pnpm -F ranuts doc:api:check && pnpm -F docs check:langs",
    "verify:design": "node bin/run-checks.ts verify:design",
    "verify:packages": "node bin/verify-packages.ts",
    "verify:consumers": "pnpm -F ranuts verify:package && node bin/verify-package-consumers.ts",
    "verify:links": "node bin/verify-md-links.ts",
    "publint": "pnpm exec publint packages/ranui && pnpm exec publint packages/ranuts && pnpm exec publint packages/ranview",
    "verify:agent-evals": "node --test --test-concurrency=1 plugins/ran/evals/*.test.ts",
    "verify:scripts": "node --test bin/test/*.test.ts",
    "release:check": "node bin/release.ts check",
    "release:prepare": "node bin/release.ts prepare",
    "release:dry-run": "node bin/release.ts dry-run",
    "release:publish": "node bin/release.ts publish",
    "verify:release": "node bin/verify-release-install.ts",
    "typecheck:tooling": "tsc --project tsconfig.tooling.json",
    "sync:design": "node bin/sync-design-docs.ts",
    "sync:agent-plugin": "node bin/sync-agent-plugin.ts",
    "verify:agent-plugin": "node bin/sync-agent-plugin.ts --check"
  },
  "homepage": "https://ran.chaxus.com/",
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "jscpd": "5.4.2",
    "oxlint": "1.89.0",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "@playwright/test": "1.64.1",
    "vite": "catalog:"
  },
  "packageManager": "pnpm@11.6.0"
}
