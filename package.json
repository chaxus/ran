{
  "name": "@ran/monorepo",
  "version": "1.0.0",
  "description": "Monorepo",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "pre": "sh ./bin/preinstall.sh",
    "preinstall": "npx only-allow pnpm",
    "clean": "sh ./bin/clean.sh",
    "build": "sh ./bin/build.sh",
    "test": "sh ./bin/test.sh",
    "lint": "sh ./bin/lint.sh",
    "lint:es": "oxlint --config .oxlintrc.json .",
    "lint:fix": "oxlint --config .oxlintrc.json --fix .",
    "lint:prettier": "prettier --check --cache .",
    "format": "prettier --write --cache .",
    "cpd": "jscpd ./packages",
    "verify:docs": "pnpm -F ranui doc:api:check && pnpm -F ranui doc:style:check && pnpm -F ranuts doc:api:check",
    "verify:design": "pnpm -F ranui verify:design",
    "publint": "pnpm exec publint packages/ranui && pnpm exec publint packages/ranuts"
  },
  "homepage": "https://ran.chaxus.com/",
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "jscpd": "5.0.14",
    "oxlint": "1.77.0",
    "prettier": "3.9.6",
    "publint": "0.3.24"
  }
}
