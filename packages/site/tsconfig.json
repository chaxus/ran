{
  "extends": "../../tsconfig.base.json",
  "exclude": ["node_modules/**", "dist/**", "public/**"],
  "include": ["**/*.ts", "**/*.d.ts"],
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "rootDir": ".",
    "noUnusedLocals": true,
    "verbatimModuleSyntax": false,
    "types": ["node"]
  }
}
