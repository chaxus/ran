  "scripts": {
    "dev": "vite --host",
    "build": "sh ./bin/build.sh",
    "build:release": "sh -c \"RANUI_MINIFY=terser RANUI_CSS_MINIFY=esbuild sh ./bin/build.sh\"",
    "build:analyze": "sh -c \"RANUI_ANALYZE=true RANUI_MINIFY=esbuild RANUI_CSS_MINIFY=esbuild sh ./bin/build.sh\"",
    "build:es": "vite build -c ./build/config.es.ts",
    "build:bundle": "vite build -c ./build/config.bundle.ts",
    "build:iife": "tsx ./bin/build-iife.ts",
    "prepublish": "npm run build",
    "design:bundle": "tsx ./bin/design-bundle.ts",
    "test": "sh ./bin/test.sh",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:ssr": "vitest run --config vitest.config.ssr.ts",
    "test:ssr:watch": "vitest --config vitest.config.ssr.ts",
    "test:all": "pnpm -F ranuts build && npm run tsc && npm run test:unit && npm run test:ssr",
    "e2e:install": "playwright install chromium",
    "test:e2e": "npm run e2e:install && playwright test",
    "test:report": "playwright show-report",
    "test:ui": "npm run e2e:install && playwright test --ui",
    "test:update": "npm run e2e:install && playwright test --update-snapshots",
    "tsc": "tsc --noEmit",
    "doc:style": "tsx ./bin/generate-style-docs.ts",
    "doc:style:check": "tsx ./bin/generate-style-docs.ts --check",
    "doc:api": "tsx ./bin/generate-component-api.ts",
    "doc:api:check": "tsx ./bin/generate-component-api.ts --check",
    "doc:changelog": "tsx ./bin/generate-changelog-docs.ts",
    "doc:changelog:check": "tsx ./bin/generate-changelog-docs.ts --check",
    "verify:design": "tsx ./bin/verify-design-rules.ts --ignore components/math/temml.css"
  },
