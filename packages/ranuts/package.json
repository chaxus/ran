{
  "name": "ranuts",
  "version": "0.5.1",
  "description": "Tree-shakeable TypeScript utility library: DOM/BOM helpers, string/object/number/color utils, debounce/throttle/compose, a 2D rendering engine and a virtual DOM.",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "type": "module",
  "sideEffects": [
    "./dist/iife/**"
  ],
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./utils": {
      "types": "./dist/src/utils/index.d.ts",
      "import": "./dist/src/utils/index.js"
    },
    "./visual": {
      "types": "./dist/src/utils/visual/index.d.ts",
      "import": "./dist/src/utils/visual/index.js"
    },
    "./sw": {
      "types": "./dist/src/sw/index.d.ts",
      "import": "./dist/src/sw/index.js"
    },
    "./i18n": {
      "types": "./dist/src/utils/i18n.d.ts",
      "import": "./dist/src/utils/i18n/index.js"
    },
    "./vnode": {
      "types": "./dist/src/vnode/index.d.ts",
      "import": "./dist/src/vnode/index.js"
    },
    "./stream": {
      "types": "./dist/src/stream/index.d.ts",
      "import": "./dist/src/stream/index.js"
    },
    "./conversation": {
      "types": "./dist/src/conversation/index.d.ts",
      "import": "./dist/src/conversation/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chaxus/ran.git",
    "directory": "packages/ranuts"
  },
  "bugs": {
    "url": "https://github.com/chaxus/ran/issues"
  },
  "homepage": "https://ran.chaxus.com/src/ranuts/",
  "files": [
    "dist",
    "typings.d.ts",
    "CLAUDE.md",
    "docs/API.md"
  ],
  "scripts": {
    "build": "sh ./bin/build.sh",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify:package": "node bin/verify-package.ts",
    "tsc": "tsc --noEmit",
    "dev": "vite --host",
    "doc:api": "tsx ./bin/generate-api-docs.ts",
    "doc:api:check": "tsx ./bin/generate-api-docs.ts --check",
    "prepack": "pnpm run build"
  },
  "keywords": [
    "ranuts",
    "utils",
    "utilities",
    "typescript",
    "javascript",
    "debounce",
    "throttle",
    "compose",
    "dom",
    "bom",
    "virtual-dom",
    "canvas",
    "webgl",
    "webgpu",
    "tree-shakeable",
    "i18n",
    "indexeddb",
    "web-worker",
    "service-worker",
    "postmessage",
    "zip",
    "audio-recorder",
    "speech-recognition",
    "totp",
    "color",
    "storage"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@webgpu/types": "0.1.71",
    "jsdom": "30.0.1",
    "terser": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "jschardet": "3.1.4"
  }
}
