{
  "name": "docs",
  "version": "1.0.0",
  "description": "ran.chaxus.com \u2014 product website, design methods and library documentation",
  "type": "module",
  "scripts": {
    "dev": "tsx build/dev.ts",
    "preview": "tsx build/preview.ts",
    "build": "sh ./bin/build.sh",
    "verify": "tsx build/verify.ts",
    "tsc": "tsc --noEmit",
    "check:langs": "node bin/check-langs.ts",
    "test": "vitest run",
    "verify:design": "tsx ../ranui/bin/verify-design-rules.ts --roots styles --tokens ../ranui/theme/tokens.less --baseline design-baseline.json",
    "test:preview": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chaxus/ran",
    "directory": "packages/docs"
  },
  "bugs": {
    "url": "https://github.com/chaxus/ran/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [],
  "author": "chaxus",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "jsdom": "30.1.3",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@ranui/preview": "0.3.0",
    "minisearch": "7.2.0",
    "ranpress": "workspace:*",
    "ranui": "workspace:*",
    "ranuts": "workspace:*"
  },
  "private": true
