# ── Clean URLs: the retired `/src/…` trees ──────────────────────────────────
# The build replaces the next line with the rules from build/urls.ts, one hop from every
# old `/src/` and `/<lang>/src/` URL to its page. They follow the specific rules above
# and precede the `.html` catch-alls below; the host takes the first match.
# @generated legacyRedirects

# ── Legacy `.html` URLs (GitHub Pages era) → extensionless ───────────────────
# VitePress cleanUrls serves `/foo` from `foo.html`; a direct `/foo.html`
# request used to 404. 301 it to the clean form. `index.html` forms (root and
# directory) are routed straight to their clean destination instead of hopping
# through the catch-all below.
/index.html / 301
/*/index.html /:splat/ 301
/*.html /:splat 301
