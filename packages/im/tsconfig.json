{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "isolatedModules": false,
    "useUnknownInCatchVariables": false,
    "inlineSourceMap": true,
    "experimentalDecorators": true,
    "paths": {
      "@/app/*": ["./app/*"],
      "@/client/*": ["./client/*"]
    }
  },
  "exclude": ["node_modules/**", "assets/**", "public/**"]
}
