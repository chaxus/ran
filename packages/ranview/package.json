{
  "name": "@alixex/ranview",
  "version": "0.1.0-alpha.0",
  "description": "Framework-free DOM construction with fine-grained reactivity — build once, update in place, in a browser or to a string",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./signal": "./src/signal.ts",
    "./mocks": "./src/mocks.ts",
    "./static": "./src/static.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chaxus/ran",
    "directory": "packages/ranview"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "author": "chaxus",
  "license": "MIT",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node ../../bin/prepare-declarations.mjs dist . && node bin/verify-static-build.mjs",
    "tsc": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "bench:ssr": "tsx ./bench/ssr.ts"
  },
  "dependencies": {
    "ranuts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "jsdom": "30.0.1",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "tsx": "catalog:"
  },
  "keywords": [
    "dom",
    "reactive",
    "signals",
    "fine-grained",
    "ssr",
    "no-vdom",
    "web-components"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/cjs-types/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./signal": {
        "import": {
          "types": "./dist/signal.d.ts",
          "default": "./dist/signal.js"
        },
        "require": {
          "types": "./dist/cjs-types/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./mocks": {
        "import": {
          "types": "./dist/mocks.d.ts",
          "default": "./dist/mocks.js"
        },
        "require": {
          "types": "./dist/cjs-types/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./static": {
        "import": {
          "types": "./dist/static.d.ts",
          "default": "./dist/static.js"
        },
        "require": {
          "types": "./dist/cjs-types/static.d.cts",
          "default": "./dist/static.cjs"
        }
      }
    }
  }
}
