{
  "extends": "../../tsconfig.base.json",
  "exclude": ["node_modules/**", "dist/**"],
  "include": ["**/*.ts", "**/*.d.ts"],
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "rootDir": ".",
    "noUnusedLocals": true
  }
}
