{
  "name": "ranpress",
  "version": "0.1.0",
  "description": "The static site generator behind ran.chaxus.com \u2014 mechanism only; the site supplies its own policy",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./search": "./src/search.ts",
    "./search-shared": "./src/search-shared.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chaxus/ran",
    "directory": "packages/ranpress"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "author": "chaxus",
  "license": "MIT",
  "scripts": {
    "tsc": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "marked": "18.0.9",
    "minisearch": "7.2.0",
    "shiki": "4.4.3",
    "vite": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
