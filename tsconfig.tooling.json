{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "bin/**/*.ts",
    "packages/ranui/bin/visual.ts",
    "packages/ranui/bin/copy-bundled-notices.ts",
    "packages/ranuts/bin/verify-package.ts",
    "packages/ranuts/bin/copy-bundled-notices.ts",
    "packages/ranview/bin/verify-static-build.ts",
    "packages/ranui/test/visual/setup.ts",
    "plugins/ran/evals/*.ts"
  ]
}
