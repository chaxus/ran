-pre {
-  white-space: pre-wrap;
-  overflow: hidden;
-  user-select: none;
+.code-frame {
+  padding: 0;
+  border: 0;
+  border-radius: 0;
+  background: transparent;
 }
+.code-actions {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: var(--ran-space-2, 8px);
+  margin-bottom: var(--ran-space-3, 12px);
+}
+.code-actions button {
+  min-height: 40px;
+  padding: 8px 12px;
+  border: 1px solid #bcc5d0;
+  border-radius: var(--ran-radius-sm, 6px);
+  color: inherit;
+  background: white;
+  font-size: var(--ran-text-button-size, 14px);
+  font-weight: var(--ran-text-button-weight, 500);
+  line-height: 1;
+}
+.code-actions button:hover {
+  background: #f0f2f5;
+}
+.code-actions button:disabled {
+  cursor: wait;
+  opacity: 0.6;
+}
+#copy-status {
+  flex-basis: 100%;
+  color: #54585e;
+  font-size: var(--ran-text-label-2, 13px);
+}
+#copy-status:empty {
+  display: none;
+}
+.code-frame pre {
+  margin: 0;
+  padding: var(--ran-space-4, 16px);
+  max-height: 60vh;
+  white-space: pre;
+  overflow: auto;
+  user-select: text;
+  tab-size: 4;
+  background: white;
+  font-family: var(--ran-font-mono, ui-monospace, SFMono-Regular, Consolas, monospace);
+  font-size: var(--ran-text-label-1, 14px);
+  line-height: 1.6;
+}
+.code-frame code {
+  font: inherit;
+}
+.code-frame :focus-visible {
+  outline: 2px solid #1755a2;
+  outline-offset: 2px;
+}
+@media (pointer: coarse) {
+  .code-actions button {
+    min-height: 44px;
+  }
+}
